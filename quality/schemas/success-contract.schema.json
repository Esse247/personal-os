{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality/schemas/success-contract.schema.json",
  "title": "PERSONAL OS quality-gauntlet success contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "goal",
    "milestone",
    "owner_role",
    "scope",
    "iteration_budget",
    "criteria",
    "required_reviewers",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "$ref": "#/$defs/id" },
    "goal": { "$ref": "#/$defs/nonEmpty" },
    "milestone": { "$ref": "#/$defs/nonEmpty" },
    "created_at": { "type": "string", "format": "date-time" },
    "owner_role": { "$ref": "#/$defs/id" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": { "$ref": "#/$defs/nonEmptyStrings" },
        "out": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "iteration_budget": { "type": "integer", "minimum": 1, "maximum": 5 },
    "budget_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["justification", "approved_by"],
      "properties": {
        "justification": { "$ref": "#/$defs/nonEmpty" },
        "approved_by": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "risk_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "lineage": { "$ref": "#/$defs/contractLineage" },
    "references": { "$ref": "#/$defs/repoRefs" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requiredReviewer" }
    },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "escalate"],
      "properties": {
        "success": { "$ref": "#/$defs/nonEmptyStrings" },
        "escalate": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "repoRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "description",
        "mandatory",
        "severity_on_fail",
        "evaluator",
        "expected"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "class": { "enum": ["capability", "regression", "review"] },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "mandatory": { "type": "boolean" },
        "severity_on_fail": { "enum": ["P0", "P1", "P2", "P3"] },
        "evaluator": {
          "enum": [
            "deterministic",
            "static_analysis",
            "security_scan",
            "integration",
            "artifact_inspection",
            "independent_review",
            "model_review",
            "human_review",
            "browser",
            "authorization"
          ]
        },
        "command": { "type": ["string", "null"] },
        "expected": { "$ref": "#/$defs/nonEmpty" },
        "risk_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "rubric_ref": { "type": "string", "minLength": 1 }
      }
    },
    "requiredReviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "independent"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "independent": { "const": true },
        "rubric_ref": { "type": "string", "minLength": 1 },
        "minimum_score": { "type": "number" }
      }
    },
    "contractLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes_contract_id",
        "predecessor_run_id",
        "escalation_resolution_ref"
      ],
      "properties": {
        "supersedes_contract_id": { "$ref": "#/$defs/id" },
        "predecessor_run_id": { "$ref": "#/$defs/id" },
        "escalation_resolution_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
