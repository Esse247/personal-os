# Foundation v0.2 accepts only mock adapters and synthetic data.
PERSONAL_OS_ENV=development
PERSONAL_OS_PROVIDER_MODE=mock
PERSONAL_OS_DATABASE_URL=sqlite:///./backend/personal_os.db
PERSONAL_OS_BIND_HOST=127.0.0.1
PERSONAL_OS_BIND_PORT=8000
PERSONAL_OS_AUTO_INITIALIZE=true
# Docker Compose embeds a fixed synthetic local-only database account; do not add secrets here.
